# Copy to /opt/dronehub/.env on the server. Never commit the real file.
POSTGRES_DB=dronehub_production
POSTGRES_USER=dronehub
POSTGRES_PASSWORD=replace-with-a-long-random-secret
JWT_SECRET=replace-with-at-least-32-random-characters
SECRET_KEY_BASE=replace-with-a-long-random-secret

# Set these only if the application uses the corresponding integration.
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Containers bind to loopback only. A host reverse proxy owns public TLS.
WEB_PORT=3000
API_PORT=3001
